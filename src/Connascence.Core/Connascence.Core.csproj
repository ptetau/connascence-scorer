<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <NeedsRoslyn>true</NeedsRoslyn>
    <CopyRoslyn>true</CopyRoslyn>
    <RootNamespace>Connascence</RootNamespace>
    <!-- Core source is also compiled into the Roslyn analyzer (netstandard2.0),
         so keep to APIs that exist in netstandard2.0. -->
  </PropertyGroup>

  <!-- A functional core, checked by FunctionalLint (external/functional-csharp). See docs/functional-core.md. -->
  <Import Project="..\..\external\functional-csharp\FunctionalLint\build\FunctionalCore.props" />
</Project>
