#!/bin/sh
# Connascence gate for this repo, using the analyzer built from this checkout (dogfooding the current code).
# Then, when the commit touches Connascence.Core, the FunctionalLint gate (scripts/functional-gate.py).
# Turn it on once per clone:  git config core.hooksPath .githooks
# Agents: read the report, then follow the connascence-review skill (see CLAUDE.md).
# Skip once with: git commit --no-verify
root=$(git rev-parse --show-toplevel)
dotnet=$(command -v dotnet || true)
for d in "${DOTNET_ROOT:-}" "$HOME/.dotnet"; do
  [ -z "$dotnet" ] && [ -n "$d" ] && [ -x "$d/dotnet" ] && dotnet="$d/dotnet"
done
if [ -z "$dotnet" ]; then
  echo "connascence: dotnet not found; skipping the coupling check"
  exit 0
fi
if ! "$dotnet" build "$root/src/Connascence.Cli" -c Release -nologo -v q >/dev/null 2>&1; then
  echo "connascence: the CLI doesn't build at this commit; skipping the coupling check"
  exit 0
fi
status=0
"$dotnet" "$root/src/Connascence.Cli/bin/Release/net11.0/connascence.dll" check --staged --no-git "$root" || status=1

# FunctionalLint: Connascence.Core is a functional core (see docs/functional-core.md).
if git diff --cached --name-only | grep -qE '^(src/Connascence\.Core/|functionallint\.policy$|\.functionallint-baseline\.json$|external/functional-csharp$)'; then
  if [ ! -f "$root/external/functional-csharp/FunctionalLint/heal.sh" ]; then
    echo "functional gate: external/functional-csharp is missing (git submodule update --init); skipping"
  elif ! command -v python3 >/dev/null 2>&1; then
    echo "functional gate: python3 not found; skipping"
  else
    PATH="$(dirname "$dotnet"):$PATH" python3 "$root/scripts/functional-gate.py" || status=1
  fi
fi
exit $status
