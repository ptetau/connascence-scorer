#!/bin/sh
# Connascence gate for this repo, using the analyzer built from this checkout (dogfooding the current code).
# Turn it on once per clone:  git config core.hooksPath .githooks
# Agents: read the report, then follow the connascence-review skill (see CLAUDE.md).
# Skip once with: git commit --no-verify
root=$(git rev-parse --show-toplevel)
if ! command -v dotnet >/dev/null 2>&1; then
  echo "connascence: dotnet not found; skipping the coupling check"
  exit 0
fi
if ! dotnet build "$root/src/Connascence.Cli" -c Release -nologo -v q >/dev/null 2>&1; then
  echo "connascence: the CLI doesn't build at this commit; skipping the coupling check"
  exit 0
fi
dotnet "$root/src/Connascence.Cli/bin/Release/net8.0/connascence.dll" check --staged --no-git "$root"
